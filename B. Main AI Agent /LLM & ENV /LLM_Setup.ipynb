    "# Diagnostic Code\n",
    "\n",
    "import os\n",
    "from google import genai\n",
    "\n",
    "# PASTE YOUR NEW KEY FROM THE ALTERNATE ACCOUNT HERE\n",
    "ALT_ACCOUNT_KEY = \"PASTE_YOUR_API_KEY_HERE"\n",
    "\n",
    "def diagnose_alt_account():\n",
    "    client = genai.Client(api_key=ALT_ACCOUNT_KEY)\n",
    "    print(\"🔍 DIAGNOSING ALTERNATE ACCOUNT MODELS...\")\n",
    "    \n",
    "    try:\n",
    "        # This will tell us exactly what strings your account supports\n",
    "        models = client.models.list()\n",
    "        available_names = [m.name for m in models]\n",
    "        \n",
    "        for name in available_names:\n",
    "            print(f\"✅ Available: {name}\")\n",
    "\n",
    "        if \"models/gemini-1.5-flash\" in available_names:\n",
    "            print(\"\\n🚀 TESTING CONNECTION...\")\n",
    "            response = client.models.generate_content(\n",
    "                model=\"gemini-1.5-flash\", \n",
    "                contents=\"Verify connection.\"\n",
    "            )\n",
    "            print(f\"🤖 Response: {response.text}\")\n",
    "            print(\"\\n🌟 SUCCESS! Use this account for the project.\")\n",
    "        else:\n",
    "            print(\"\\n❌ gemini-1.5-flash not found in this account's list.\")\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"❌ CRITICAL FAILURE: {e}\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    diagnose_alt_account()"
   ]
