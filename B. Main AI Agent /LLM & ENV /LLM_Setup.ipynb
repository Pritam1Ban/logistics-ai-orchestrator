    "import os\n",
    "from dotenv import load_dotenv\n",
    "from langchain_google_genai import ChatGoogleGenerativeAI\n",
    "\n",
    "# 1. Configuration of Paths\n",
    "ENV_PATH = r\"B:\\3. Prog\\2. Projects\\7. Logistics and supply chain\\B. Main AI Agent\\LLM & ENV\\LLM_API.env\"\n",
    "\n",
    "# 2. CLEAR CACHED KEYS (The \"Memory Flush\")\n",
    "if \"GOOGLE_API_KEY\" in os.environ:\n",
    "    del os.environ[\"GOOGLE_API_KEY\"]\n",
    "\n",
    "# 3. Load the specific .env file\n",
    "if os.path.exists(ENV_PATH):\n",
    "    # override=True forces it to replace any old keys hidden in memory\n",
    "    load_dotenv(dotenv_path=ENV_PATH, override=True)\n",
    "else:\n",
    "    print(f\"⚠️ Warning: .env file not found at {ENV_PATH}\")\n",
    "\n",
    "def get_llm():\n",
    "    \"\"\"\n",
    "    Initializes the Gemini 2.0 Flash brain using the refreshed environment.\n",
    "    \"\"\"\n",
    "    api_key = os.getenv(\"GOOGLE_API_KEY\")\n",
    "    \n",
    "    if not api_key:\n",
    "        raise ValueError(f\"❌ CRITICAL: GOOGLE_API_KEY not found in {ENV_PATH}\")\n",
    "\n",
    "    return ChatGoogleGenerativeAI(\n",
    "        model=\"gemini-2.0-flash\", \n",
    "        temperature=0,\n",
    "        google_api_key=api_key,\n",
    "        convert_system_message_to_human=True\n",
    "    )\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    print(\"🚀 Running Flush & Connect...\")\n",
    "    try:\n",
    "        brain = get_llm()\n",
    "        response = brain.invoke(\"Connection test: Confirm 2026 status.\")\n",
